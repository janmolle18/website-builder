# Vorlage — echte Werte NUR in .env (nicht committen)
CLAUDE_CODE_OAUTH_TOKEN=
GOOGLE_PLACES_API_KEY=
NOTION_TOKEN=
NOTION_DB_ID=
PORT=3000
ADMIN_TOKEN=
# SMTP für Ticket-Benachrichtigungen (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INQUIRY_NOTIFY_EMAIL=
# Vercel-Deploy (optional, sonst `vercel login`)
VERCEL_TOKEN=
# Nur setzen, wenn lokale SSL-Kette Probleme macht (deaktiviert TLS-Prüfung!):
# NODE_TLS_REJECT_UNAUTHORIZED=0
# Absender für Outreach-Mails (optional)
SENDER_NAME=
SENDER_TAGLINE=
